{
  "manifest_version": 3,
  "name": "DIMY",
  "version": "1.1.1",
  "description": "ディミの画面の中で Web ページを開けるようにする（ディミの画面の中で開くときだけ、ページの「中に表示しないで」の印を外す）。ディミの中の ChatGPT がログインした状態で使えるよう、ChatGPT のログイン情報だけ枠の中にも送る設定にする。ディミの画面の写真を撮る。",
  "minimum_chrome_version": "116",
  "permissions": [
    "declarativeNetRequest",
    "alarms",
    "tabs",
    "scripting",
    "cookies",
    "contentSettings"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "frame",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://dimy.dxdimix.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
